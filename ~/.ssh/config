# Default permissions check
# File permissions must be 600 (chmod 600 ~/.ssh/config)

# Personal GitHub
Host github.com-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes

# Work / Secondary GitHub
Host github.com-work
    HostName gh.io
    User git
    IdentityFile ~/.ssh/id_ed25519_work
    IdentitiesOnly yes

# Custom Git Server (e.g., Qubu Git)
Host git.qubu.ai
    HostName qubu
    User git
    IdentityFile ~/.ssh/id_ed25519_qubu
    IdentitiesOnly yes
